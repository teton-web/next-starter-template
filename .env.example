# Reference only — do not commit real values.
# Manage secrets in Doppler. Local: doppler setup --project next-starter-template --config development

# Required
DATABASE_URL=
AUTH_SECRET=

# Auth & email
# AUTH_SECRET is the Better Auth secret (Better Auth also accepts BETTER_AUTH_SECRET as an alias — keep a single Doppler name).
# AUTH_URL is the Better Auth base URL (alias of BETTER_AUTH_URL).
RESEND_API_KEY=
EMAIL_FROM=
AUTH_URL=
NEXT_PUBLIC_BASE_URL=

# Public site
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
CANONICAL_SITE_URL=
SEARCH_INDEXING_ENABLED=false
INDEXABLE_HOSTS=
CONTACT_TO_EMAIL=

# Object storage (required on Vercel preview/production)
BLOB_READ_WRITE_TOKEN=

# Site gate (Vercel preview/production only; sync to preview + production)
SITE_GATE_PASSWORD=

# Optional fallback when DATABASE_URL is unset
NEON_DATABASE_URL=

# Local development only (Doppler development config — do not sync to Vercel)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to false in CI/e2e so the seed admin can use the CMS without first-login.
SEED_ADMIN_MUST_CHANGE_PASSWORD=
