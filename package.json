  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "David Solheim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsolheim/next-starter-template.git"
  },
  "bugs": {
    "url": "https://github.com/davidsolheim/next-starter-template/issues"
  },
  "homepage": "https://github.com/davidsolheim/next-starter-template#readme",
  "scripts": {
    "build": "next build",
    "build:doppler": "doppler run -- next build",
    "dev": "doppler run -- next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "audit": "bun audit --audit-level=high",
    "doppler:setup": "doppler setup --project next-starter-template --config development --no-interactive",
    "doppler:import:vercel": "bash scripts/doppler-import-from-vercel.sh",
    "start": "next start",
    "start:doppler": "doppler run -- next start",
    "db:generate": "doppler run -- bunx drizzle-kit generate",
    "db:migrate": "doppler run -- bunx drizzle-kit migrate",
    "db:push": "bun -e \"console.error('db:push is disabled. Use bun run db:generate then bun run db:migrate.'); process.exit(1)\"",
    "db:push:force": "bun -e \"console.error('db:push:force is disabled. Use bun run db:generate then bun run db:migrate.'); process.exit(1)\"",
    "db:studio": "doppler run -- bunx drizzle-kit studio",
    "db:seed": "doppler run -- bun scripts/seed-admin.ts",
    "env:verify": "bun scripts/verify-env-contract.mjs",
    "env:verify:doppler": "doppler run -- bun scripts/verify-env-contract.mjs",
    "doppler:verify": "bun scripts/verify-doppler-config.mjs"
  },
